{
  "name": "nidingen-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:api": "cd .. && uv run python -m app.api.export_openapi web/openapi.json && cd web && openapi-typescript openapi.json -o src/lib/api-types.ts",
    "predev": "npm run gen:tokens",
    "dev": "vite",
    "prebuild": "npm run gen:tokens",
    "build": "tsc --noEmit && vite build",
    "pretest": "npm run gen:tokens",
    "test": "vitest run",
    "pretypecheck": "npm run gen:tokens",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tanstack/react-query": "^5.108.0",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "react-router": "^7.18.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
